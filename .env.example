# Web Scraper Configuration Template
# Copy this file to .env to set local environment variables if needed.

# Playwright / Browser settings
# SCRAPER_HEADLESS=true

# Proxy configuration (if needed)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080

# Custom default User-Agent override (optional)
# SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
